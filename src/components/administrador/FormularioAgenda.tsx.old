// Subcomponente para gestionar los rangos dinámicos por día
const DiaItem = ({ index, nombreDia, isActivo, control, register }: any) => {
  const { fields, append, remove } = useFieldArray({
    control,
    name: `dias.${index}.rangos`,
  });

  return (
    <Card className="bg-light">
      <Card.Body className="p-3">
        <div className="d-flex align-items-center justify-content-between">
          <Form.Check
            type="checkbox"
            id={`dia-activo-${index}`}
            label={<span className="fw-semibold">{nombreDia}</span>}
            {...register(`dias.${index}`)}
          />

          {isActivo && (
            <Button
              type="button"
              variant="outline-primary"
              size="sm"
              onClick={() => append({ horaInicio: '08:00', horaFin: '12:00' })}
            >
              + Agregar Rango Horario
            </Button>
          )}
        </div>

        {isActivo && (
          <div className="d-flex flex-column gap-2 mt-3 ps-4">
            {fields.map((field, rIndex) => (
              <div key={field.id} className="d-flex align-items-center flex-wrap gap-2">
                <small className="text-muted fw-medium">Rango {rIndex + 1}:</small>
                <InputGroup size="sm" style={{ width: 'auto' }}>
                  <Form.Control
                    type="time"
                    aria-label={`Hora de inicio del rango ${rIndex + 1}`}
                    {...register(`dias.${index}.rangos.${rIndex}.horaInicio`)}
                  />
                  <InputGroup.Text>a</InputGroup.Text>
                  <Form.Control
                    type="time"
                    aria-label={`Hora de fin del rango ${rIndex + 1}`}
                    {...register(`dias.${index}.rangos.${rIndex}.horaFin`)}
                  />
                </InputGroup>
                {fields.length > 1 && (
                  <Button
                    type="button"
                    variant="link"
                    size="sm"
                    className="text-danger fw-bold text-decoration-none"
                    aria-label={`Quitar rango ${rIndex + 1}`}
                    onClick={() => remove(rIndex)}
                  >
                    ✕
                  </Button>
                )}
              </div>
            ))}
          </div>
        )}
      </Card.Body>
    </Card>
  );
};


export default FormularioAgendaMedico;